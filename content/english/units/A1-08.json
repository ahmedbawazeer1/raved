              "you",
              "You like potatoes.",
              "You don't like garlic."
            ],
            [
              "we",
              "We like cucumber.",
              "We don't like cabbage."
            ],
            [
              "they",
              "They like carrots.",
              "They don't like pepper."
            ]
          ]
        },
