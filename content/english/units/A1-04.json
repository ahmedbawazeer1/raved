              "That is a door.",
              "تلك باب.",
              "شيء بعيد"
            ],
            [
              "What is this?",
              "ما هذا؟",
              "سؤال عن شيء قريب"
            ],
            [
              "It is a pen.",
              "إنه قلم.",
              "الجواب"
            ]
          ]
        },
