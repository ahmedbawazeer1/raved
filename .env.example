# Names only. Real values go in Vercel → Settings → Environment Variables.
# Never put real keys in this file or anywhere in GitHub.

# Supabase (set automatically by the Supabase ↔ Vercel integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# The integration may set these older names instead; either works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Optional: without it, emails are skipped and in-app notifications still work.
RESEND_API_KEY=
EMAIL_FROM=

# Protects the daily cleanup job (Vercel sends it automatically when set).
CRON_SECRET=

# AI (Groq, free tier). Without it, speaking/writing evaluation and the assistant show "not enabled yet".
GROQ_API_KEY=
# Optional model overrides. By default the app picks the first model Groq still offers from src/lib/ai/models.ts.
# GROQ_EVAL_MODEL=
# GROQ_ASSISTANT_MODEL=
# GROQ_TRANSCRIBE_MODEL=
# Tests only (CI): deterministic fake AI answers. Ignored on Vercel.
# RAVED_AI_FAKE=1
