# Names only. Real values go in Vercel → Settings → Environment Variables.
# Never put real keys in this file or anywhere in GitHub.

# Supabase (set automatically by the Supabase ↔ Vercel integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# The integration may set these older names instead; either works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Optional: without it, emails are skipped and in-app notifications still work.
RESEND_API_KEY=
EMAIL_FROM=

# Protects the daily cleanup job (Vercel sends it automatically when set).
CRON_SECRET=
